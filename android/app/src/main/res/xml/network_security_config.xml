<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pruebas en red local: se permite HTTP normal (backend en :3000) y los
         certificados propios/instalados por el usuario (Vite en HTTPS :5173). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
