PORT=3000
# 0.0.0.0 permite conectarse desde el celular/lector en la misma red Wi-Fi.
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/levis"
#inventario

# SEGURIDAD: genera un secreto real con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIA_ESTA_CLAVE_POR_UNA_CADENA_LARGA_ALEATORIA"

# Orígenes permitidos (separados por coma). Además, el backend acepta
# automáticamente cualquier IP de la red local (192.168.x.x, 10.x.x.x, 172.16-31.x.x).
# FRONTEND_URL="http://localhost:51737667"

# Rate limiting (opcional - descomentar solo en pruebas E2E o lectores Zebra rápidos)
# AUTH_RATE_LIMIT_MAX=200    # max intentos de login (por defecto: 50)
# SCAN_RATE_LIMIT_MAX=5000   # max escaneos por 15 min por usuario (por defecto: 5000)
# API_RATE_LIMIT_MAX=1000    # max peticiones generales a la API (por defecto: 300)
