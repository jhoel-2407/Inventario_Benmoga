generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADORA
  EMPLEADO
}

enum EstadoInventario {
  BORRADOR
  ACTIVO
  CERRADO
}

enum EstadoSesionZona {
  ACTIVA
  FINALIZADA
}

enum TipoZona {
  PDV
  BODEGA
}

model Local {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique @db.VarChar(120)
  activo      Boolean      @default(true)
  creadoEn    DateTime     @default(now())
  perfilColumnas Json?
  maestraPlantilla MaestraPlantilla?
  zonas       Zona[]
  inventarios Inventario[]
}

model MaestraPlantilla {
  id            Int      @id @default(autoincrement())
  localId       Int      @unique
  nombreArchivo String   @db.VarChar(255)
  contenido     Bytes    @db.MediumBlob
  actualizadoEn DateTime @updatedAt
  local         Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
}

model Usuario {
  id             Int            @id @default(autoincrement())
  nombre         String         @db.VarChar(120)
  correo         String         @unique @db.VarChar(190)
  passwordHash   String         @db.VarChar(255)
  rol            RolUsuario     @default(EMPLEADO)
  color          String?        @db.VarChar(9)
  activo         Boolean        @default(true)
  creadoEn       DateTime       @default(now())
  tokenVersion   Int            @default(0)
  sesionesZona   SesionZona[]
  escaneos       Escaneo[]
  inventariosCreados Inventario[]
  escaneosNovedad   EscaneoNovedad[]
}

model Zona {
  id             Int            @id @default(autoincrement())
  localId        Int
  inventarioId    Int?
  numero         Int
  nombre         String?        @db.VarChar(100)
  tipo           TipoZona       @default(PDV)
  activa         Boolean        @default(true)
  local          Local          @relation(fields: [localId], references: [id], onDelete: Cascade)
  inventario     Inventario?    @relation(fields: [inventarioId], references: [id])
  sesiones       SesionZona[]
  escaneos       Escaneo[]
  escaneosNovedad EscaneoNovedad[]
  @@unique([localId, inventarioId, numero])
}

model Inventario {
  id             Int                  @id @default(autoincrement())
  localId        Int
  nombre         String               @db.VarChar(180)
  fechaInventario DateTime            @default(now())
  estado         EstadoInventario     @default(BORRADOR)
  archivoOrigen  String?              @db.VarChar(255)
  creadoPorId    Int
  creadoEn       DateTime             @default(now())
  local          Local                @relation(fields: [localId], references: [id])
  productos      InventarioProducto[]
  escaneos       Escaneo[]
  escaneosNovedad EscaneoNovedad[]
  zonas          Zona[]
  creadoPor      Usuario              @relation(fields: [creadoPorId], references: [id])
  @@index([estado, fechaInventario])
  @@index([localId, estado])
}

model Producto {
  id             Int                  @id @default(autoincrement())
  codigoBarras   String               @db.VarChar(64)
  item           String?              @db.VarChar(64)
  descripcion    String?              @db.VarChar(255)
  detalle1       String?              @db.VarChar(120)
  detalle2       String?              @db.VarChar(120)
  genero         String?              @db.VarChar(100)
  estilo         String?              @db.VarChar(100)
  referencia     String?              @db.VarChar(100)
  subGrupo       String?              @db.VarChar(100)
  creadoEn       DateTime             @default(now())
  inventarios    InventarioProducto[]
  @@unique([codigoBarras])
  @@index([descripcion])
  @@index([referencia])
}

model InventarioProducto {
  id                 Int        @id @default(autoincrement())
  inventarioId       Int
  productoId         Int
  existenciaInicial  Int        @default(0)
  // Copia exacta de los descriptores del maestro para ESTE inventario. El
  // catálogo global Producto se conserva como respaldo/catálogo compartido,
  // pero cada tienda ve el texto literal de su propio Excel.
  item               String?    @db.VarChar(64)
  descripcion        String?    @db.VarChar(255)
  detalle1           String?    @db.VarChar(120)
  detalle2           String?    @db.VarChar(120)
  genero             String?    @db.VarChar(100)
  estilo             String?    @db.VarChar(100)
  referencia         String?    @db.VarChar(100)
  subGrupo           String?    @db.VarChar(100)
  // true = los campos anteriores son la fuente autoritativa de este inventario
  // (aunque sean null). false = fila antigua o de prueba: se usa Producto.
  descriptoresCargados Boolean  @default(false)
  creadoEn           DateTime   @default(now())
  inventario         Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  producto           Producto   @relation(fields: [productoId], references: [id])
  escaneos           Escaneo[]
  @@unique([inventarioId, productoId])
  @@index([inventarioId])
}

model SesionZona {
  id             Int                @id @default(autoincrement())
  usuarioId      Int
  zonaId         Int
  estado         EstadoSesionZona   @default(ACTIVA)
  inicio         DateTime           @default(now())
  fin            DateTime?
  usuario        Usuario            @relation(fields: [usuarioId], references: [id])
  zona           Zona               @relation(fields: [zonaId], references: [id])
  @@index([estado, zonaId])
  @@index([usuarioId, estado])
}

model Escaneo {
  id                    BigInt             @id @default(autoincrement())
  inventarioId          Int
  inventarioProductoId  Int
  usuarioId             Int
  zonaId                Int
  codigoLeido           String             @db.VarChar(64)
  cantidad              Int                @default(1)
  leidoEn               DateTime           @default(now())
  inventario            Inventario         @relation(fields: [inventarioId], references: [id])
  inventarioProducto    InventarioProducto @relation(fields: [inventarioProductoId], references: [id])
  usuario               Usuario            @relation(fields: [usuarioId], references: [id])
  zona                  Zona               @relation(fields: [zonaId], references: [id])
  @@index([inventarioId, zonaId, leidoEn])
  @@index([inventarioProductoId])
  @@index([usuarioId, leidoEn])
  // Índices de conteo: evitan que las consultas de totales/unos por zona
  // lean la tabla completa mientras el conteo crece.
  @@index([zonaId, leidoEn])
  @@index([zonaId, codigoLeido])
  @@index([zonaId, cantidad])
  @@index([inventarioId, usuarioId, inventarioProductoId])
}

model TokenRevocado {
  id        Int      @id @default(autoincrement())
  jti       String   @unique @db.VarChar(64)
  usuarioId Int
  expiraEn  DateTime
  creadoEn  DateTime @default(now())
  @@index([expiraEn])
}

model EscaneoNovedad {
  id            Int        @id @default(autoincrement())
  inventarioId  Int
  zonaId        Int
  usuarioId     Int
  codigoLeido   String     @db.VarChar(64)
  descripcion   String?    @db.VarChar(255)
  leidoEn       DateTime   @default(now())
  posicion      Int
  inventario    Inventario @relation(fields: [inventarioId], references: [id])
  zona          Zona       @relation(fields: [zonaId], references: [id])
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])
  @@index([inventarioId])
  @@index([zonaId])
  @@index([zonaId, leidoEn])
}
